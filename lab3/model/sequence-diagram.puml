' Lab 3 · Task 3 · SchemaPostol Sequence Diagram
' Covers Scenario 1 (Classic Registration & Login),
' Scenario 2 (Microsoft OAuth Session Creation),
' Scenario 3 (Session Verification & Token Rotation).
' Consistent with lab3/spec.md, lab1/model/er-diagram.mmd,
' lab3/adr/0007-sessions-storage.md, lab2/adr/0005-oauth-for-authoring.md.
'
' Activation rule (spec requirement 4): every activate has a paired
' deactivate at the same nesting level. Each activation bar opens BEFORE
' a flow block (alt/else or opt) and closes AFTER it, never left hanging
' across alt/else boundaries.

@startuml
autonumber
title SchemaPostol - Authentication & Session Sequence (Lab 3, Task 3)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 220
skinparam wrapWidth 260

' ---------- Human actors (Lab 2, Task 2 naming) ----------
actor "Guest" as Guest
actor "Registered User" as RegUser
actor "Author" as Author

' ---------- System boundary participants ----------
participant "Frontend" as FE
participant "Backend" as BE

' ---------- External system (Lab 2, Task 2 naming) ----------
participant "Microsoft OAuth Service" as MS <<System>>

' ---------- Database entities (Lab 1 ERD + ADR-0007) ----------
database "User" as UserDB
database "Session" as SessionDB

note right of Guest
  Human actors use the platform as three roles.
  An Author IS an elevated Registered User who linked a
  licensed Microsoft/Mojang game account via OAuth (ADR-0005).
end note

'
' ======================= SCENARIO 1 =======================
'
== Scenario 1: Classic Registration & Login ==

Guest -> FE : click "Register" and enter\nregistration data (nickname, email, password)
FE -> BE : POST /auth/register\n{nickname, email, password}
activate BE
BE -> UserDB : findByEmail(email), findByNickname(nickname)
activate UserDB
UserDB --> BE : existing user | null
deactivate UserDB
alt invalid input - user already exists
  BE --> FE : 409 Conflict {error: "nickname or email already taken"}
else valid input - new user
  BE -> BE : hashPassword(password)
  BE -> UserDB : INSERT {user_id, nickname, email, password_hash}
  activate UserDB
  UserDB --> BE : OK
  deactivate UserDB
  BE --> FE : 201 Created {userId}
end
deactivate BE
note over BE : Validation failed -> registration rejected; otherwise the\nnew User row is persisted. Flow continues into Login (step 2).

Guest -> FE : click "Login" and enter credentials\n(email, password)
FE -> BE : POST /auth/login {email, password}
activate BE
BE -> UserDB : findByEmail(email)
activate UserDB
UserDB --> BE : user {user_id, password_hash} | null
deactivate UserDB
alt no user with such email
  BE --> FE : 401 Unauthorized {error: "invalid credentials"}
else user found
  BE -> BE : hashPassword(password) and compare its\nsalt against stored password_hash
  alt password mismatch
    BE --> FE : 401 Unauthorized {error: "invalid credentials"}
  else password matches
    BE -> BE : generate refreshToken (7 days) +\naccessToken (15 min JWT)
    BE -> SessionDB : createSession(user_id, hash(refreshToken), ip, userAgent)
    activate SessionDB
    SessionDB --> BE : session_id
    deactivate SessionDB
    BE --> FE : 200 OK - accessToken (json) +\nrefreshToken (HttpOnly, Secure, Domain cookie)
  end
end
deactivate BE
FE -> FE : store accessToken & refreshToken cookie

'
' ======================= SCENARIO 2 =======================
'
== Scenario 2: Microsoft OAuth Session Creation ==

Guest -> FE : click "Sign in with Microsoft"
FE -> BE : GET /auth/oauth/microsoft (request authorize URL)
activate BE
BE -> BE : generate random state (CSRF protection)
BE --> FE : 200 OK {authorizeUrl, state}
deactivate BE

FE -> Guest : redirect to Microsoft authorization page
Guest -> MS : enter Microsoft credentials and consent
MS --> Guest : user consents to share account data
MS --> FE : redirect with temporary authorization code (+ state)
FE -> BE : POST /auth/oauth/microsoft/callback\n{code, state}
activate BE
alt state mismatch OR authorization code invalid
  BE --> FE : 401 Unauthorized {error: "OAuth authentication failed"}
else callback valid
  BE -> MS : exchange authorization code for token pair
  activate MS
  MS --> BE : {microsoftAccessToken, microsoftRefreshToken}
  deactivate MS
  BE -> MS : GET user profile (Bearer microsoftAccessToken)
  activate MS
  MS --> BE : Microsoft account data {nickname, email}
  deactivate MS
  BE -> UserDB : findByEmail(email)
  activate UserDB
  UserDB --> BE : existing user | null
  deactivate UserDB
  opt first sign-in - user row does not exist yet
    BE -> UserDB : INSERT {user_id, nickname, email, password_hash: null}
    activate UserDB
    UserDB --> BE : OK
    deactivate UserDB
  end
  opt Microsoft account proves licensed game ownership (ADR-0005)
    BE -> BE : promoteToAuthor(user_id) -\nRegistered User elevated to Author
  end
  BE -> BE : generate own refreshToken (7 days) +\naccessToken (15 min JWT)
  BE -> SessionDB : createSession(user_id, hash(refreshToken), sessionInfo)
  activate SessionDB
  SessionDB --> BE : session_id
  deactivate SessionDB
  BE --> FE : 200 OK - accessToken (json) +\nrefreshToken (HttpOnly, Secure, Domain cookie)
end
deactivate BE
FE -> FE : store accessToken & refreshToken cookie

note over BE
  Role elevation (ADR-0005): a Registered User who links a licensed
  Minecraft account through Microsoft OAuth is promoted to Author.
end note

'
' ======================= SCENARIO 3 =======================
'
== Scenario 3: Session Verification & Token Rotation ==

RegUser -> FE : perform an authorized action
FE -> BE : GET /api/schematics (Bearer accessToken)
activate BE
BE -> BE : verifyJwt(accessToken)
alt accessToken valid
  BE --> FE : 200 OK - requested operation executed
else accessToken invalid / expired
  BE --> FE : 401 Unauthorized {error: "refresh token required"}
end
deactivate BE

opt access token was rejected - token rotation
  FE -> BE : POST /auth/refresh (refreshToken HttpOnly cookie)
  activate BE
  BE -> SessionDB : findByHash(hash(refreshToken)) + check expires_at
  activate SessionDB
  SessionDB --> BE : session | null
  deactivate SessionDB
  alt refreshToken valid (session exists, not expired)
    BE -> BE : rotate - generate new accessToken + refreshToken
    BE -> SessionDB : updateSession(session_id, hash(newRefreshToken))
    activate SessionDB
    SessionDB --> BE : OK
    deactivate SessionDB
    BE --> FE : 200 OK - new accessToken (json) +\nnew refreshToken (HttpOnly cookie)
  else refreshToken invalid / expired / stolen
    BE -> SessionDB : deleteSession(session_id)
    activate SessionDB
    SessionDB --> BE : OK
    deactivate SessionDB
    BE --> FE : 401 Unauthorized - clear refreshToken cookie
  end
  deactivate BE
  FE -> FE : store new tokens OR clear tokens (user becomes Guest)
end

' ---------- Consistency notes ----------
note over UserDB
  User entity (Lab 1 ERD): user_id (PK), nickname (UK),
  email (UK), password_hash, created_at.
end note

note over SessionDB
  Session entity (ADR-0007): session_id (PK), user_id (FK -> User),
  refresh_token_hash, session info (ip, user_agent), created_at, expires_at.
  Refresh token stored HASHED; strict rotation on POST /auth/refresh.
end note

@enduml